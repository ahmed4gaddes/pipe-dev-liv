# ==============================================================================
#  PIPE-DEV-LIV — Variables d'environnement (TEMPLATE)
#
#  Instructions :
#    1. Copiez ce fichier :  cp .env.example .env
#    2. Remplissez les valeurs avec vos propres mots de passe et tokens
#    3. Ne commitez JAMAIS le fichier .env
# ==============================================================================

# === Base de données (commun à tous les microservices) ===
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# === Keycloak (IAM / SSO) ===
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=CHANGE_ME
KC_DB_USER=keycloak
KC_DB_PASSWORD=CHANGE_ME
KC_REALM=pipe-dev-liv
KC_CLIENT_ID=ticketing-app
KC_AUTH_SERVER_URL=http://localhost:9090

# === RabbitMQ (Message Broker) ===
RABBIT_USER=guest
RABBIT_PASSWORD=CHANGE_ME
RABBIT_HOST=localhost
RABBIT_PORT=5672

# === SonarQube (Qualité du code) ===
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=CHANGE_ME
SONAR_TOKEN=CHANGE_ME

# === GitHub (API & Webhooks) ===
GH_PAT_TOKEN=CHANGE_ME
GH_WEBHOOK_SECRET=CHANGE_ME
GH_OWNER=your-github-username
GH_REPO=pipe-dev-liv

# === Eureka (Service Discovery) ===
EUREKA_HOST=localhost
EUREKA_PORT=8761

# === Zipkin (Distributed Tracing) ===
ZIPKIN_HOST=localhost
ZIPKIN_PORT=9411

# === Profil Spring Boot actif ===
SPRING_PROFILES_ACTIVE=dev
